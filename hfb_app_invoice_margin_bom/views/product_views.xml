<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_bom_margin" model="ir.ui.view">
        <field name="name">product.template.form.inherit.bom.margin</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group name="bom_margin" string="Invoice Cost &amp; Margin" groups="hfb_app_invoice_margin_bom.group_invoice_margin">
                    <group>
                        <field name="bom_cost_skip"/>
                        <field name="bom_cost_no_explode" invisible="bom_cost_skip or bom_cost_fixed_ok"/>
                        <field name="bom_cost_leaf_source" invisible="bom_cost_skip or bom_cost_fixed_ok"/>
                    </group>
                    <group>
                        <field name="bom_cost_fixed_ok" invisible="bom_cost_skip"/>
                        <label for="bom_cost_fixed" invisible="bom_cost_skip or not bom_cost_fixed_ok"/>
                        <div class="o_row" invisible="bom_cost_skip or not bom_cost_fixed_ok">
                            <field name="bom_cost_fixed"/>
                            <field name="bom_cost_fixed_currency_id" options="{'no_create': True, 'no_open': True}"/>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
