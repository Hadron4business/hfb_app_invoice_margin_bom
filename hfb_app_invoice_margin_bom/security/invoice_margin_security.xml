<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_invoice_margin" model="res.groups">
        <field name="name">Show Invoice Cost &amp; Margin</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_invoice_margin'))]"/>
    </record>

    <record id="account_move_extra_cost_company_rule" model="ir.rule">
        <field name="name">Invoice extra cost: multi-company</field>
        <field name="model_id" ref="model_account_move_extra_cost"/>
        <field name="domain_force">[('move_id.company_id', 'in', company_ids)]</field>
    </record>

</odoo>
